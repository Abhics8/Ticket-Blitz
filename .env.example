# --- Database (Postgres) ---
DATABASE_URL="postgresql://user:password@localhost:5432/ticket_blitz"

# --- Redis (distributed locks, rate limiter, idempotency, waiting room, Socket.IO adapter) ---
REDIS_URL="redis://localhost:6379"

# --- Kafka / Redpanda (comma-separated brokers) ---
KAFKA_BROKERS="localhost:9092"

# --- API ---
PORT=3000
INSTANCE_ID="api-1"
LOG_LEVEL="info"

# --- Concurrency / reservation tuning ---
LOCK_TTL_SECONDS=10
HOLD_TTL_SECONDS=120
SWEEP_MS=2000
OUTBOX_POLL_MS=500

# --- Rate limiter (token bucket) ---
RL_CAPACITY=20
RL_REFILL=10

# --- Virtual waiting room (surge control) ---
WAITING_ROOM=false
WR_ADMIT=50
WR_TICK_MS=1000
WR_ADMIT_TTL=300

# --- Tracing (OpenTelemetry -> Jaeger/Tempo) ---
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318/v1/traces"
OTEL_SERVICE_NAME="ticket-blitz"
